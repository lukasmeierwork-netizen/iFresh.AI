# Copy this file to `.env.local` and fill in values from your Supabase project.
# Only `EXPO_PUBLIC_*` variables are inlined into the client bundle.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
EXPO_PUBLIC_BACKEND_ORIGIN=http://localhost:3001

# Dev only: set to 1 to open the app on main tabs without signing in (requires __DEV__).
# EXPO_PUBLIC_DEV_SKIP_ONBOARDING=1

# Near-vision test: target holding distance (cm) and ± tolerance (cm).
# EXPO_PUBLIC_NEAR_VISION_TARGET_CM=40
# EXPO_PUBLIC_NEAR_VISION_TOLERANCE_CM=4
# Optional override for near-vision results upload endpoint.
# EXPO_PUBLIC_NEAR_VISION_RESULTS_URL=http://localhost:3001/vision/near-results

# App Store / Play auto-renewable subscription product IDs (defaults: com.tb.* in store-iap.ts).
# EXPO_PUBLIC_PLAN_CATALOG_ID_WEEKLY=com.tb.weekly
# EXPO_PUBLIC_PLAN_CATALOG_ID_MONTHLY=com.tb.monthly
# EXPO_PUBLIC_PLAN_CATALOG_ID_YEARLY=com.tb.yearly

# Default onboarding row → `plan_catalog.id` (free tier). See frontend/src/constants/plan-catalog.ts.
# EXPO_PUBLIC_PLAN_CATALOG_ID_FREE=
